{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suas.local/schemas/funding-readiness/evidence-artifact.v0.json",
  "title": "EvidenceArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "scenario_id", "recorded_at_utc", "suas_env", "purpose_class", "software_revision", "spec_version", "release_manifest", "input_provenance", "output_provenance", "operator_action", "intervention_state", "retention_class"],
  "properties": {
    "schema_version": { "const": "evidence-artifact.v0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "recorded_at_utc": { "type": "string", "minLength": 1 },
    "suas_env": { "enum": ["LOCAL", "TEST", "STAGING", "PRODUCTION"] },
    "purpose_class": { "enum": ["ENGINEERING", "CONTROLLED_EXPERIMENT", "DEMO", "FIELD"] },
    "software_revision": { "type": "string", "minLength": 1 },
    "spec_version": { "type": "string", "minLength": 1 },
    "release_manifest": { "type": "string", "minLength": 1 },
    "configuration_revision": { "type": ["string", "null"] },
    "model_provider_id": { "type": ["string", "null"] },
    "model_version": { "type": ["string", "null"] },
    "input_provenance": { "type": "string", "minLength": 1 },
    "output_provenance": { "type": "string", "minLength": 1 },
    "operator_ref": { "type": ["string", "null"] },
    "system_state": { "type": ["string", "null"] },
    "confidence": { "type": ["object", "null"] },
    "operator_action": { "enum": ["ACCEPT", "REJECT", "MODIFY", "ABSTAIN_ACK", "ABORT", "NONE"] },
    "intervention_state": { "enum": ["NONE", "INTERVENED", "ABSTAINED", "UNAVAILABLE"] },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "errors": { "type": "array", "items": { "type": "object" } },
    "recovery_events": { "type": "array", "items": { "type": "object" } },
    "resulting_state": { "type": ["string", "null"] },
    "evaluation_method": { "type": ["string", "null"] },
    "evaluator_ref": { "type": ["string", "null"] },
    "artifact_digest": { "type": ["string", "null"] },
    "lineage": { "type": "array", "items": { "type": "string" } },
    "retention_class": { "type": "string", "minLength": 1 }
  }
}
