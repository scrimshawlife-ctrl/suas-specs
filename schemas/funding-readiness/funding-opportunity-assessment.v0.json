{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suas.local/schemas/funding-readiness/funding-opportunity-assessment.v0.json",
  "title": "FundingOpportunityAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "opportunity_id", "current_suas_evidence_coverage", "evidence_gaps", "administrative_gaps", "eligibility_status", "workflow_status", "provenance", "last_verified_date"],
  "properties": {
    "schema_version": { "const": "funding-opportunity-assessment.v0" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "opportunity_id": { "type": "string", "minLength": 1 },
    "agency": { "type": ["string", "null"] },
    "program": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "publication_date": { "type": ["string", "null"] },
    "deadline": { "type": ["string", "null"] },
    "applicant_eligibility": { "type": ["string", "null"] },
    "technical_topic": { "type": ["string", "null"] },
    "research_alignment": { "type": ["string", "null"] },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "required_partners": { "type": "array", "items": { "type": "string" } },
    "cost_share_requirement": { "type": ["string", "null"] },
    "trl_expectation": { "type": ["string", "null"] },
    "data_management_requirements": { "type": ["string", "null"] },
    "security_requirements": { "type": ["string", "null"] },
    "reporting_requirements": { "type": ["string", "null"] },
    "current_suas_evidence_coverage": { "type": "string", "minLength": 1 },
    "evidence_gaps": { "type": "string", "minLength": 1 },
    "administrative_gaps": { "type": "string", "minLength": 1 },
    "eligibility_status": { "enum": ["ELIGIBLE", "POTENTIALLY_ELIGIBLE", "INELIGIBLE", "NOT_COMPUTABLE"] },
    "workflow_status": { "enum": ["DISCOVERED", "SCREENING", "ELIGIBILITY_VERIFIED", "EVIDENCE_GAP_ANALYSIS", "READY", "NOT_READY", "INELIGIBLE", "EXPIRED"] },
    "provenance": { "type": "string", "minLength": 1 },
    "last_verified_date": { "type": "string", "minLength": 1 }
  }
}
